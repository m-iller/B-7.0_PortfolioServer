# Runtime
NODE_ENV=production
PORT=3000
# Public origin used for CORS and cookie scope. Use your VDS URL in production.
PUBLIC_ORIGIN=http://localhost:3000

# SQLite (Docker compose overrides this to file:/app/data/portfolio.db)
DATABASE_URL=file:./data/portfolio.db

# Auth — JWT_SECRET must be >= 32 random characters in production
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# First-run admin (password is hashed with bcrypt before storage)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisAdminPass1!

# Telegram worker (leave token empty to no-op the bot container)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# Uploads
UPLOAD_MAX_MB=64
