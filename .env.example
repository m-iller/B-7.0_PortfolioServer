# Runtime
NODE_ENV=production
PORT=3000
# Public origin used for CORS and cookie scope. Use your VDS URL in production.
PUBLIC_ORIGIN=http://localhost:3000

# SQLite path is relative to prisma/schema.prisma unless absolute.
# Local `npm run dev:web` pins an absolute path if this is missing or file:./...
# Docker overrides this to file:///app/data/portfolio.db.
DATABASE_URL=file:../data/portfolio.db

# Auth — JWT_SECRET must be >= 32 random characters in production
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# First-run admin (password is hashed with bcrypt before storage)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisAdminPass1!

# Telegram DND bot (leave token empty to idle the bot container)
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user id. Can edit settings/places in every group. Group creators can too.
TELEGRAM_ADMIN_ID=

# Uploads
UPLOAD_MAX_MB=64
# Unused files in ./uploads are deleted after this age (minutes)
MEDIA_CLEANUP_GRACE_MIN=30
# How often the web container sweeps unused media (minutes)
MEDIA_CLEANUP_INTERVAL_MIN=60
