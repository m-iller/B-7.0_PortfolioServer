generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ProjectFolder {
  id        String    @id @default(cuid())
  titleEn   String
  titleRu   String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id             String         @id @default(cuid())
  title          String         @default("")
  description    String         @default("")
  titleEn        String         @default("")
  titleRu        String         @default("")
  descriptionEn  String         @default("")
  descriptionRu  String         @default("")
  images         String
  videos         String         @default("[]")
  tagsLinks      String
  youtubeUrl     String         @default("")
  sortOrder      Int            @default(0)
  folderId       String?
  folder         ProjectFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
}

model Skill {
  id                  String @id @default(cuid())
  title               String @default("")
  category            String @default("")
  experienceYears     Float
  proficiencyLevel    String @default("")
  description         String @default("")
  titleEn             String @default("")
  titleRu             String @default("")
  categoryEn          String @default("")
  categoryRu          String @default("")
  proficiencyLevelEn  String @default("")
  proficiencyLevelRu  String @default("")
  descriptionEn       String @default("")
  descriptionRu       String @default("")
}

model Experience {
  id                   String @id @default(cuid())
  companyOrProject     String @default("")
  role                 String @default("")
  description          String @default("")
  period               String
  companyOrProjectEn   String @default("")
  companyOrProjectRu   String @default("")
  roleEn               String @default("")
  roleRu               String @default("")
  descriptionEn        String @default("")
  descriptionRu        String @default("")
}

model Education {
  id             String @id @default(cuid())
  institution    String @default("")
  specialty      String @default("")
  details        String @default("")
  institutionEn  String @default("")
  institutionRu  String @default("")
  specialtyEn    String @default("")
  specialtyRu    String @default("")
  detailsEn      String @default("")
  detailsRu      String @default("")
}

model Profile {
  id      String @id
  nameEn  String @default("")
  nameRu  String @default("")
  aboutEn String @default("")
  aboutRu String @default("")
}

model ProfileItem {
  id        String @id @default(cuid())
  labelEn   String
  labelRu   String
  value     String
  url       String @default("")
  sortOrder Int    @default(0)
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
