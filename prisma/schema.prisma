generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id             String   @id @default(cuid())
  title          String   @default("")
  description    String   @default("")
  titleEn        String   @default("")
  titleRu        String   @default("")
  descriptionEn  String   @default("")
  descriptionRu  String   @default("")
  images         String
  videos         String   @default("[]")
  tagsLinks      String
  youtubeUrl     String   @default("")
  createdAt      DateTime @default(now())
}

model Skill {
  id               String @id @default(cuid())
  title            String
  category         String
  experienceYears  Float
  proficiencyLevel String
  description      String
}

model Experience {
  id               String @id @default(cuid())
  companyOrProject String
  role             String
  description      String
  period           String
}

model Education {
  id          String @id @default(cuid())
  institution String
  specialty   String
  details     String
}

model Profile {
  id      String @id
  nameEn  String @default("")
  nameRu  String @default("")
  aboutEn String @default("")
  aboutRu String @default("")
}

model ProfileItem {
  id        String @id @default(cuid())
  labelEn   String
  labelRu   String
  value     String
  url       String @default("")
  sortOrder Int    @default(0)
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
